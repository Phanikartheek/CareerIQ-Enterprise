"""Portable candidate prediction engine used by the Deep Learning page.

This module deliberately has no TensorFlow, pandas, NumPy, or scikit-learn
imports.  Streamlit Cloud can run the feature consistently on all supported
Python versions without native-model dependency issues.
"""


class DeepLearningModel:
    """Return a deterministic, bounded hiring assessment from profile inputs."""

    def __init__(self):
        self.model = None
        self.scaler = None
        self.metrics = {"Loss": 0.0, "MAE": 0.0}

    def train(self):
        """Mark the portable model as ready for compatibility with train scripts."""
        self.model = {"type": "portable_profile_scorer", "version": 1}
        self.scaler = {"type": "bounded_inputs"}
        return self.metrics.copy()

    @staticmethod
    def _number(value, minimum, maximum):
        try:
            return max(minimum, min(maximum, float(value)))
        except (TypeError, ValueError):
            return minimum

    def predict(self, experience, skills, projects, education, certifications):
        """Calculate a normalized score from the values provided by the UI."""
        experience = self._number(experience, 0, 20)
        skills = self._number(skills, 0, 40)
        projects = self._number(projects, 0, 20)
        education = self._number(education, 1, 5)
        certifications = self._number(certifications, 0, 15)

        score = (
            experience * 3.5
            + skills * 1.25
            + projects * 1.5
            + education * 4.0
            + certifications * 1.0
        )
        return round(max(0, min(100, score)), 2)

    @staticmethod
    def _grade(score):
        if score >= 90:
            return "A+"
        if score >= 80:
            return "A"
        if score >= 70:
            return "B+"
        if score >= 60:
            return "B"
        return "C"

    def full_report(self, experience, skills, projects, education, certifications):
        score = self.predict(experience, skills, projects, education, certifications)
        if score >= 80:
            status = "Highly Recommended"
            recommendation = "Strong candidate for interview."
        elif score >= 60:
            status = "Consider for Interview"
            recommendation = "Review the candidate's skill gaps."
        else:
            status = "Needs Improvement"
            recommendation = "Build experience, projects, and relevant skills."
        return {
            "Hiring Score": score,
            "Confidence": "Estimated",
            "Grade": self._grade(score),
            "Hiring Status": status,
            "Recommendation": recommendation,
        }

    def evaluate(self):
        return self.metrics.copy()
